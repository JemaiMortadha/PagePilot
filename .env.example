# ============================================================
# FB Page Automation - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- GEMINI API (Free - get at https://aistudio.google.com/) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- APIFY (Free $5/mo credits - get at https://apify.com/) ---
APIFY_API_TOKEN=your_apify_api_token_here

# --- FACEBOOK (Your OWN page - Graph API) ---
# Get from: https://developers.facebook.com/
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# --- COMPETITOR PAGES TO MONITOR ---
# Comma-separated Facebook page URLs to scrape for new posts
COMPETITOR_PAGES=https://www.facebook.com/PageOne,https://www.facebook.com/PageTwo

# --- YOUR PAGE BRAND/WATERMARK ---
PAGE_NAME=YourPageName

# --- SETTINGS ---
# How many recent posts to check per competitor page
POSTS_TO_CHECK=5
# Minimum hours between re-posting the same content
DEDUP_HOURS=72
